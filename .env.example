# ── Delivery: choose ONE mode ──────────────────────────────────────────────
# BOT MODE (recommended — adds real "Apply" buttons). Set both of these and the
# webhook below is ignored. Get the token from the Developer Portal > your app >
# Bot. Get the channel id by enabling Developer Mode in Discord, then
# right-clicking the channel > Copy Channel ID.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# WEBHOOK MODE (fallback — apply shows as a clickable link, not a button).
# Used only when DISCORD_BOT_TOKEN / DISCORD_CHANNEL_ID are blank.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Your server's id — optional but recommended. With it, sorpple.py registers its
# slash commands to that one guild, which is INSTANT. Without it they sync
# globally and can take up to an hour to appear. Enable Developer Mode, then
# right-click the server icon > Copy Server ID.
DISCORD_GUILD_ID=

# ── Year pings (sorpple.py) ─────────────────────────────────────────────────
# When a new listing's text mentions a year, sorpple.py pings the role set here
# for that year -- e.g. a listing saying "2027 intake" pings @2027Start.
# Value can be a bare role id or a <@&id> mention. Right-click the role >
# Copy Role ID. The role must be mentionable, or the bot needs "Mention Everyone".
# Add PING_ROLE_2028 etc. later; no code change needed.
# Listings with no year match post with NO mention at all.
PING_ROLE_2027=

# LEGACY -- used by the standalone *_bot.py / *_monitor.py scripts only.
# sorpple.py no longer applies this: it pings year roles and nothing else.
# Examples: @here  |  @everyone  |  <@&123456789012345678> (a role id)
DISCORD_PING=@here

# LEGACY -- standalone scripts only. sorpple.py uses the per-source
# *_POLL_MINUTES settings below instead.
POLL_INTERVAL_SECONDS=300

# ── Per-source poll intervals (sorpple.py), in minutes ──────────────────────
# Indeed is deliberately the slowest: every Indeed request goes through a paid
# rotating proxy to get past Cloudflare, while Prosple and JobStreet are free.
# These are only the STARTING values -- /interval changes them live and the new
# value is saved to sorpple_settings.json, which then wins over these.
PROSPLE_POLL_MINUTES=10
JOBSTREET_POLL_MINUTES=10
INDEED_POLL_MINUTES=30

# How many of the latest internships to seed on the very first run.
INIT_COUNT=10

# How many internships to pull from the API each poll.
FETCH_LIMIT=30

# Include the full job description (collapsed behind a spoiler) in each post.
# Set to false to skip the extra per-listing fetch and keep posts compact.
INCLUDE_DESCRIPTION=true

# ── Indeed monitor (indeed_monitor.py) ──────────────────────────────────────
# Path to a Wolveproxy-format proxy list (host:port:user:password, one per line).
# Defaults to proxies.txt in the same folder as the script.  Proxies are used
# automatically if the file exists; Indeed's Cloudflare protection may block
# direct requests from a residential or data-centre IP.
# INDEED_PROXIES_FILE=proxies.txt

# Set to false/0 to disable proxy rotation entirely (direct requests only).
# INDEED_USE_PROXIES=true
